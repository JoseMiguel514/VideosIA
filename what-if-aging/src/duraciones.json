 "telomeres": {
  "dur": 18.506,
  "sents": [
   {
    "t": "Deep inside your body, something has changed.",
    "s": 0.0,
    "e": 2.774
   },
   {
    "t": "Normally, every time most of your cells divide, the protective caps on your chromosomes, called telomeres, get a little shorter.",
    "s": 3.154,
    "e": 11.452
   },
   {
    "t": "Eventually, the cell stops dividing for good.",
    "s": 11.832,
    "e": 14.798
   },
   {
    "t": "In your frozen body, that clock never runs down.",
    "s": 15.178,
    "e": 18.506
   }
  ]
 },
